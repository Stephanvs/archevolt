<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>false</PublishAot>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmEnableThreads>false</WasmEnableThreads>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Archeoids/Game.cs" Link="Game.cs" />
    <Compile Include="../Archeoids/GameModel.cs" Link="GameModel.cs" />
    <Compile Include="../Archeoids/GameSystems.cs" Link="GameSystems.cs" />
    <Compile Include="../Archeoids/FrameGeometry.cs" Link="FrameGeometry.cs" />
    <ProjectReference Include="../../src/Archevolt/Archevolt.csproj" />
    <ProjectReference Include="../../src/Archevolt.Generators/Archevolt.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
