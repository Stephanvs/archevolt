---
import arrowRight from "@phosphor-icons/core/assets/bold/arrow-right-bold.svg?raw";
import check from "@phosphor-icons/core/assets/bold/check-bold.svg?raw";
import copy from "@phosphor-icons/core/assets/bold/copy-bold.svg?raw";
import plus from "@phosphor-icons/core/assets/bold/plus-bold.svg?raw";

const icons = { "arrow-right": arrowRight, check, copy, plus } as const;

interface Props {
  name: keyof typeof icons;
  class?: string;
}

const { name, class: className } = Astro.props;
const svg = icons[name].replace("<svg ", `<svg aria-hidden="true" focusable="false" class="icon ${className ?? ""}" `);
---

<Fragment set:html={svg} />
