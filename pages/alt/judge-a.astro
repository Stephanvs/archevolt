---
/**
 * judge-a: Judge A's structure (.arena/landing/judge-a.md, sections 3, 4, and 6), built on the value spine
 * (.arena/landing/out-spine.md). A hero and three value chapters: plain C#, speed, and architecture.
 * Every number comes from pages/_alt/evidence.ts with its scope beside it.
 */
import AltLayout from "../_alt/AltLayout.astro";
import "../_alt/judge-a.css";
import { Code } from "astro:components";
import { Image } from "astro:assets";
import data from "blume:data";
import archeoids from "../../docs/samples/archeoids.png";
import Icon from "../_home/Icon.astro";
import InstallCommand from "../_home/InstallCommand.astro";
import TaglineReveal from "../_home/TaglineReveal.astro";
import ExecutionVisual from "../_home/visuals/ExecutionVisual.astro";
import MessagesVisual from "../_home/visuals/MessagesVisual.astro";
import QueryVisual from "../_home/visuals/QueryVisual.astro";
import ScheduleVisual from "../_home/visuals/ScheduleVisual.astro";
import * as ev from "../_alt/evidence";

const codeTheme = data.config.codeThemes.dark;

const title = "Archevolt: fast simulations in plain C#";
const description =
  "Archevolt is a headless entity component system for .NET. Write components as structs and systems as static methods. A source generator compiles them into direct calls, and qualifying methods into SIMD loops. An MIT research project for .NET 11.";

/** Split text on backticks so inline code renders as <code>. */
const segments = (text: string) => text.split("`").map((part, index) => ({ code: index % 2 === 1, part }));

const values = [
  {
    id: "write",
    n: "01",
    label: "Write plain C#",
    proof: "Structs and static methods. A broken declaration fails the build.",
  },
  {
    id: "fast",
    n: "02",
    label: "Keep every update fast",
    proof: "Qualifying methods compile to SIMD loops. The numbers come with their gaps.",
  },
  {
    id: "architecture",
    n: "03",
    label: "Choose the architecture",
    proof: "No window and no engine. Your host, your loop, serial or parallel.",
  },
];

/* 01 */

const writeFacts = [
  { label: "You write", body: "Components as unmanaged structs and systems as static methods. Attributes name the order." },
  {
    label: "The generator writes",
    body: "Typed query rows, direct calls to your methods, and schedule plans, in your partial types and namespace.",
  },
  {
    label: "The build checks",
    body: `${ev.diagnostics.total} diagnostics, ${ev.diagnostics.errors} of them errors. A declaration that cannot compile to the generated form fails the build.`,
  },
];

const proofCards = {
  first: [
    {
      key: "query",
      wide: true,
      label: "Queries",
      title: "Typed rows, no lookups",
      body: "The method's `ref` and `in` parameters become a typed query. At run time it reads only the archetype tables that hold both components, with nothing boxed or looked up by type.",
      href: ev.links.queries,
      cta: "Queries guide",
    },
    {
      key: "schedule",
      label: "Schedules",
      title: "Ordering you declare once",
      body: "Order systems with `Order`, `Before`, `After`, stages, and sets. Where access conflicts, the planner adds a conservative order.",
      href: ev.links.schedules,
      cta: "Schedules guide",
    },
  ],
  third: [
    {
      key: "exec",
      wide: true,
      label: "Execution",
      title: "Serial until you opt in",
      body: "Serial execution is the reference behavior. Call `UseParallelExecution` on `WorldBuilder` for a bounded worker pool, and mark eligible systems as partitioned.",
      href: ev.links.execution,
      cta: "Execution guide",
    },
    {
      key: "messages",
      label: "Data flow",
      title: "Messages with independent readers",
      body: "Each reader consumes messages at its own pace. Resources hold shared state, and change tracking finds added and changed components.",
      href: ev.links.messages,
      cta: "Messages guide",
    },
  ],
};

/* docs/concepts/architecture.mdx, the table under "Architecture". */
const splitRows = [
  ["Named query rows, enumerators, and shapes", "Which archetypes currently match a query"],
  ["Direct calls to your system methods", "Table traversal and row-range partitioning"],
  ["Bundle descriptors and module manifests", "World registration and validation"],
  ["Declarative schedule plans", "Binding, barriers, and command playback"],
];

/* A Changed<T> filter on heroCode's Position, which has no [TrackChanges]. It produces ev.av006. */
const changedQuery = `[Query, Read<Position>, Changed<Position>]
public readonly ref partial struct Moved;`;

const programSteps = [
  {
    title: "Collect systems into a module",
    body: "A module gathers systems and bundles. A schedule declares which systems run and in what order.",
    code: ev.moduleCode,
  },
  {
    title: "Build a world and run it",
    body: "Spawn entities from bundles, bind the schedule to the world, and run it once per update.",
    code: ev.runCode,
  },
];

/* 02 */

const { kernel, bevyParity, allocation, unchangedScan, dispatch } = ev.perfFacts;
const us = (value: number) => value.toFixed(1);
const maxUs = Math.max(...ev.movement.map((row) => row.us));
const rowTag = (row: ev.MovementRow) =>
  row.kind === "baseline" ? `baseline, no scheduler · ${row.date}` : row.kind === "reference" ? `reference · ${row.date}` : row.date;

const kernelScope = [
  { label: "Compiles to a kernel", body: ev.kernelScope.qualifies },
  { label: "Keeps the call per entity", body: ev.kernelScope.doesNot },
  { label: "Same bits", body: ev.kernelScope.correctness },
  { label: "Debug builds", body: ev.kernelScope.debug },
];

/* 03 */

const callouts = [
  { label: "ship", x: 52.9, y: 46.7 },
  { label: "rock", x: 55.5, y: 24.1 },
  { label: "rock", x: 35.9, y: 57.5 },
  { label: "8 entities", x: 91.5, y: 91.1, align: "end" },
];

const fitFacts = [
  { label: "Engine", body: ev.facts.engine },
  { label: "Package", body: ev.facts.package },
  { label: "Deployment", body: ev.facts.deployment, link: { href: ev.links.validation, text: "How it is validated" } },
  {
    label: "Composition",
    body: "Modules collect systems and bundles. Schedules order them with `Order`, `Before`, `After`, stages, and sets, and `BoundSchedule.Bind` composes a schedule at run time.",
  },
  { label: "Ownership", body: `${ev.facts.ownership} Dispose every bound schedule before its world.` },
  { label: "Requirements", body: ev.facts.requirements, link: { href: ev.links.installation, text: "Installation guide" } },
  { label: "Status", body: ev.facts.status },
  { label: "License", body: ev.facts.license, link: { href: ev.links.github, text: "Archevolt on GitHub" } },
];

const questions = [
  {
    q: "How do systems add or remove components?",
    a: `${ev.facts.structural} Outside a schedule, change the world directly on its owner thread.`,
  },
  {
    q: "What does the generator add to my project?",
    a: `${ev.facts.generated} Generated code stays in the namespace of the declaration it extends.`,
  },
  {
    q: "How does it compare with other ECS libraries?",
    a: `${ev.facts.comparisons} The performance page lists every case and what it measures.`,
  },
];
---

<AltLayout slug="judge-a" title={title} description={description}>
  <!-- Hero: what this is, whether it is for my work, and the three values -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="frame hero-inner">
      <p class="hero-badge" data-rise style="--d:0">
        <span class="pulse-dot"></span>
        Headless .NET ECS · MIT
      </p>
      <h1 class="hero-title" id="hero-title" data-rise style="--d:90">
        Build fast simulations{" "}<br />
        in plain C#
      </h1>
      <div class="hero-grid">
        <div class="hero-left">
          <p class="hero-lede" data-rise style="--d:180">
            Archevolt is an entity component system, or ECS, for .NET games and simulations. You write components as
            structs and systems as static methods. A source generator compiles them into direct calls at build time,
            and your program keeps its own host, loop, and threads.
          </p>
          <div class="hero-actions" data-rise style="--d:270">
            <a class="button" href={ev.links.quickstart}>
              Read the quickstart
              <Icon name="arrow-right" />
            </a>
            <a class="judge-a-textlink" href={ev.links.github}>Source on GitHub</a>
          </div>
          <dl class="judge-a-status" data-rise style="--d:360">
            <div>
              <dt>Status</dt>
              <dd>{ev.facts.status}</dd>
            </div>
            <div>
              <dt>Requires</dt>
              <dd>
                The .NET 11 SDK and C# 15.{" "}
                <a class="judge-a-textlink" href={ev.links.installation}>Check the requirements</a>
              </dd>
            </div>
          </dl>
        </div>
        <div class="hero-stage" data-rise style="--d:300" aria-hidden="true">
          <canvas class="hero-field" data-field></canvas>
          <div class="hero-hud">
            <span>Illustration</span>
            <span>runs no Archevolt code</span>
          </div>
        </div>
      </div>
      <nav class="judge-a-values" aria-label="The three values" data-rise style="--d:420">
        <ol>
          {
            values.map((value) => (
              <li>
                <a href={`#${value.id}`}>
                  <span class="judge-a-values-n">{value.n}</span>
                  <span class="judge-a-values-label">{value.label}</span>
                  <Icon name="arrow-right" />
                  <span class="judge-a-values-proof">{value.proof}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  <!-- 01: the ergonomic API. What would I write, and what work remains mine? -->
  <section class="section judge-a-chapter" id="write" aria-labelledby="write-title">
    <div class="frame">
      <div class="sec-label" data-reveal><span>01</span>Write plain C#</div>
      <div class="system">
        <div class="system-copy" data-reveal>
          <h2 class="sec-title" id="write-title">Write the simulation, not the plumbing</h2>
          <p class="sec-lede">
            Components are structs. A system is a static method that takes <code>ref</code> to write and
            <code>in</code> to read. The generator writes the query, the access plan, the schedule wiring, and the loop
            into your own partial types.
          </p>
          <ul class="system-facts">
            {
              writeFacts.map((fact) => (
                <li>
                  <span>{fact.label}</span>
                  {fact.body}
                </li>
              ))
            }
          </ul>
        </div>
        <figure class="window system-window" data-reveal data-story="system">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="window-file">Motion.cs</span>
            <span class="window-tag">a system, not a full program</span>
          </div>
          <div class="code">
            <Code code={ev.heroCode} lang="csharp" theme={codeTheme} />
            <span class="code-hot" aria-hidden="true"><span>runs for every matching row</span></span>
          </div>
        </figure>
      </div>

      <div class="bento judge-a-pair" data-scene>
        {
          proofCards.first.map((card, index) => (
            <a class:list={["bento-card", { "is-wide": card.wide }]} href={card.href} style={`--d:${index * 85}`}>
              <div class="bento-visual">
                {card.key === "query" && <QueryVisual />}
                {card.key === "schedule" && <ScheduleVisual />}
              </div>
              <div class="bento-body">
                <span class="mono-label">{card.label}</span>
                <h3>{card.title}</h3>
                <p>{segments(card.body).map(({ code, part }) => (code ? <code>{part}</code> : part))}</p>
                <span class="pill">
                  {card.cta}
                  <Icon name="arrow-right" />
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="judge-a-more" data-reveal>
        <details class="faq-item">
          <summary>
            <span class="judge-a-more-kicker">Depth</span>
            <span class="faq-q">What happens at compile time, and what a mistake looks like</span>
            <span class="faq-icon"><Icon name="plus" /></span>
          </summary>
          <div class="judge-a-more-body">
            <div class="judge-a-split">
              <div>
                <table class="judge-a-table">
                  <thead>
                    <tr>
                      <th scope="col">Generated at compile time</th>
                      <th scope="col">Handled at run time</th>
                    </tr>
                  </thead>
                  <tbody>
                    {
                      splitRows.map(([generated, runtime]) => (
                        <tr>
                          <td>{generated}</td>
                          <td>{runtime}</td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
                <p class="judge-a-caption">
                  The generator settles what the declarations can settle. The runtime still matches archetypes, walks
                  tables, and plays back commands. <a href={ev.links.architecture}>Read the architecture</a>
                </p>
              </div>
              <div>
                <figure class="window">
                  <div class="window-bar">
                    <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                    <span class="window-file">Moved.cs</span>
                    <span class="window-tag">dotnet build</span>
                  </div>
                  <div class="code">
                    <Code code={changedQuery} lang="csharp" theme={codeTheme} />
                  </div>
                  <p class="judge-a-buildline"><code>{ev.av006}</code></p>
                </figure>
                <p class="judge-a-caption">
                  The <code>Position</code> above has no <code>[TrackChanges]</code>, so a <code>Changed</code> filter
                  cannot see its changes. The build stops with this error instead of the query failing at run time.
                </p>
              </div>
            </div>
            <ul class="system-facts judge-a-asks">
              <li>
                <span>AV001</span>
                Generated types must be <code>partial</code>, so the generator can add members to them.
              </li>
              <li>
                <span>AV002</span>
                Components must be unmanaged structs. Reference types go in managed resources.
              </li>
              <li>
                <span>Attributes</span>
                Schedules are declared with attributes on a partial class.
              </li>
            </ul>
            <p class="judge-a-caption">
              {ev.diagnostics.total} diagnostics, {ev.diagnostics.errors} of them errors. {ev.diagnostics.warning} warns
              when two conflicting systems have no explicit order, and the planner picks a conservative one.{" "}
              <a href={ev.links.diagnostics}>Read every diagnostic</a>
            </p>
          </div>
        </details>
        <details class="faq-item">
          <summary>
            <span class="judge-a-more-kicker">Setup</span>
            <span class="faq-q">See the module, schedule, and world around this system</span>
            <span class="faq-icon"><Icon name="plus" /></span>
          </summary>
          <div class="judge-a-more-body">
            <ol class="steps">
              {
                programSteps.map((step, index) => (
                  <li class="step">
                    <span class="step-number" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <div class="step-copy">
                      <h3>{step.title}</h3>
                      <p>{step.body}</p>
                    </div>
                    <div class="step-visual">
                      <div class="window">
                        <div class="code">
                          <Code code={step.code} lang="csharp" theme={codeTheme} />
                        </div>
                      </div>
                    </div>
                  </li>
                ))
              }
            </ol>
            <p class="judge-a-caption">
              The quickstart puts these pieces into one 39-line program that prints <code>1</code>.{" "}
              <a href={ev.links.quickstart}>Run the quickstart</a>
            </p>
          </div>
        </details>
      </div>

      <p class="sec-foot" data-reveal>
        <span class="judge-a-tag">When to skip it</span>
        An ECS pays for its setup when many entities mix components and many systems touch them. If every object in
        your program has the same shape and the same update, a <code>List&lt;T&gt;</code> and a <code>for</code> loop
        are simpler.
      </p>
    </div>
  </section>

  <TaglineReveal lines={["Your components stay structs.", "Your systems stay methods.", "The generator writes the wiring."]} />

  <!-- 02: performance. How fast is it, how is that measured, and where is it still slower? -->
  <section class="section judge-a-chapter" id="fast" aria-labelledby="fast-title">
    <div class="frame">
      <div class="sec-label" data-reveal><span>02</span>Keep every update fast</div>
      <div data-reveal>
        <h2 class="sec-title" id="fast-title">Speed is a requirement</h2>
        <p class="sec-lede">
          Every design decision has to earn its cost in the update loop. Components live in dense, aligned tables
          outside the managed heap, one table per archetype. The generator emits direct calls, with no reflection,
          boxing, delegates, or lookup by type at run time. A declaration that cannot compile to that form fails the
          build instead of running slower.
        </p>
      </div>

      <div class="judge-a-kernel">
        <div data-reveal>
          <p class="judge-a-dated">5 November 2026 · on main, not yet in a NuGet release</p>
          <p class="perf-number">{us(kernel.after)}<span class="judge-a-unit">µs</span></p>
          <p class="perf-caption">
            {kernel.scope} The same update took {us(kernel.before)} µs before the kernel.
          </p>
          <div class="judge-a-parity">
            <p class="judge-a-parity-claim">{bevyParity.claim}</p>
            <dl class="judge-a-gap-times judge-a-parity-times">
              <div>
                <dt>Archevolt <code>[Each]</code></dt>
                <dd>{us(bevyParity.archevolt)} µs</dd>
              </div>
              <div>
                <dt>Bevy 0.20 <code>for_each</code></dt>
                <dd>{us(bevyParity.bevy)} µs</dd>
              </div>
            </dl>
            <p class="judge-a-caption">{bevyParity.scope} One machine, not a ranking.</p>
          </div>
        </div>
        <div class="judge-a-kernel-code" data-reveal>
          <p class="judge-a-kernel-intro">
            You write the scalar <code>Motion.Move</code> from chapter 01. In a Release build, the generator compiles
            it into this <code>Vector256</code> loop. Real output from main, trimmed.
          </p>
          <figure class="window">
            <div class="window-bar">
              <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
              <span class="window-file">Motion.Move.g.cs</span>
              <span class="window-tag">generated · Release</span>
            </div>
            <div class="code">
              <Code code={ev.generatedKernel} lang="csharp" theme={codeTheme} />
            </div>
          </figure>
          <ul class="system-facts judge-a-scope">
            {
              kernelScope.map((item) => (
                <li>
                  <span>{item.label}</span>
                  {item.body}
                </li>
              ))
            }
          </ul>
          <p class="judge-a-caption">
            <a href={ev.links.simdKernels}>Read how SIMD kernels work</a>
          </p>
        </div>
      </div>

      <div class="perf-chart judge-a-chart" data-reveal data-bars>
        <p class="perf-chart-title">
          Moving 100,000 entities on one worker, median µs per update
          <span>
            Archevolt's times include schedule dispatch, resource access, lease checks, and query traversal. The C#
            handwritten loop has no scheduler.
          </span>
        </p>
        <table>
          <thead>
            <tr>
              <th scope="col">Case</th>
              <th scope="col" class="num">Median µs</th>
              <th scope="col" class="num">Range µs</th>
            </tr>
          </thead>
          <tbody>
            {
              ev.movement.map((row) => (
                <tr class:list={[`judge-a-row-${row.kind}`, { "is-baseline": row.kind === "baseline" }]}>
                  <th scope="row">
                    <span class="bar-label">
                      {segments(row.name).map(({ code, part }) => (code ? <code>{part}</code> : part))}
                      <span class="bar-tag">{rowTag(row)}</span>
                    </span>
                    <span class="bar" style={`--w:${((row.us / maxUs) * 100).toFixed(2)}%`}>
                      <span class="bar-fill" />
                    </span>
                  </th>
                  <td class="num">{us(row.us)}</td>
                  <td class="num">
                    {us(row.range[0])} to {us(row.range[1])}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="judge-a-chart-note">{ev.movementNote}</p>
      </div>

      <div class="judge-a-proc judge-a-block">
        <div data-reveal>
          <h3 class="judge-a-h3">How a speed change gets in</h3>
          <p class="judge-a-p">
            Performance work runs as a hill climb. A change stays only if it clears a gate fixed before any candidate
            runs.
          </p>
          <ol class="judge-a-gate">
            {ev.perfProcess.map((step) => <li>{step}</li>)}
          </ol>
          <p class="judge-a-rerun">Rerun the quick benchmark suite on your own machine.</p>
          <InstallCommand command={ev.rerunBenchmarks} />
          <p class="judge-a-links">
            <a href={ev.links.roundTwo}>Round two report</a>
            <a href={ev.links.roundOne}>Round one report</a>
            <a href={ev.links.results}>2 November results</a>
          </p>
        </div>
        <div data-reveal>
          <h3 class="judge-a-h3">What an update costs</h3>
          <p class="judge-a-p">The update loop is the budget. These are the costs that matter around it.</p>
          <dl class="perf-minis judge-a-minis">
            <div>
              <dt>{allocation.scope}</dt>
              <dd>{allocation.value}</dd>
            </div>
            <div>
              <dt>{unchangedScan.scope} Measured at the 2 November checkpoint.</dt>
              <dd>{unchangedScan.value} µs</dd>
            </div>
            <div>
              <dt>
                {dispatch.scope} The round one report measured {dispatch.before} µs before its change. Small workloads
                can cost more to dispatch in parallel than to run serially, so measure with one worker first.
              </dt>
              <dd>{dispatch.after} µs</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="judge-a-block" data-reveal>
        <h3 class="judge-a-h3">The known work</h3>
        <p class="judge-a-p">
          These cases are still slower. Archevolt was measured on 5 November and Bevy 0.20 on 2 November, on the same
          machine. The round two report names the cause of each.
        </p>
        <ul class="judge-a-gaps">
          {
            ev.gaps.map((gap) => (
              <li>
                <p class="judge-a-gap-case">
                  {segments(gap.case).map(({ code, part }) => (code ? <code>{part}</code> : part))}
                </p>
                <dl class="judge-a-gap-times">
                  <div>
                    <dt>Archevolt now</dt>
                    <dd>{gap.now}</dd>
                  </div>
                  {gap.bevy && (
                    <div>
                      <dt>Bevy 0.20</dt>
                      <dd>{gap.bevy}</dd>
                    </div>
                  )}
                </dl>
                <p class="judge-a-gap-note">{gap.note}</p>
              </li>
            ))
          }
        </ul>
        <p class="sec-foot">
          <a href={ev.links.whatRemains}>Read what remains in the round two report</a>. The{" "}
          <a href={ev.links.performance}>performance page</a> lists every case, how to reproduce it, and its limits.
        </p>
      </div>
    </div>
  </section>

  <!-- 03: flexible architecture. Can it fit my application, and how do I start? -->
  <section class="section judge-a-chapter" id="architecture" aria-labelledby="architecture-title">
    <div class="frame">
      <div class="sec-label" data-reveal><span>03</span>Choose the architecture</div>
      <div data-reveal>
        <h2 class="sec-title" id="architecture-title">A library, not an engine</h2>
        <p class="sec-lede">
          Archevolt opens no window and reads no input. It holds the simulation's state and runs its systems when your
          code calls it. You choose the host, the update loop, the threads, and how you ship.
        </p>
      </div>

      <div class="arcade judge-a-block" data-reveal>
        <div class="arcade-copy">
          <span class="mono-label">Sample · {ev.sample.name}</span>
          <h3 class="sec-title">One simulation, two hosts</h3>
          <p>{ev.sample.summary} Archevolt runs the gameplay. {ev.sample.hosts}</p>
          <p class="judge-a-revision">
            <span>Browser build</span>
            {ev.sample.browserNote}
          </p>
          <a class="button" href={ev.links.browserGame}>
            Play Archeoids in your browser
            <Icon name="arrow-right" />
          </a>
          <p class="judge-a-desktop">Or run the desktop build from a clone of the repository.</p>
          <InstallCommand command={ev.runSample} />
          <a class="pill pill-light" href={ev.links.sample}>
            Read the sample walkthrough
            <Icon name="arrow-right" />
          </a>
        </div>
        <div class="arcade-screen" data-story="arcade">
          <Image
            src={archeoids}
            alt="Archeoids gameplay with a cyan ship, drifting asteroids, and a score and lives HUD."
            widths={[640, 1100, 1600]}
            sizes="(min-width: 1024px) 640px, 100vw"
            loading="lazy"
          />
          {
            callouts.map((callout, index) => (
              <span
                class:list={["callout", { "is-end": callout.align === "end" }]}
                style={`left:${callout.x}%;top:${callout.y}%`}
                data-callout={index}
                aria-hidden="true"
              >
                <span class="callout-ring" />
                <span class="callout-tag">entity · {callout.label}</span>
              </span>
            ))
          }
        </div>
      </div>

      <div class="bento judge-a-pair" data-scene>
        {
          proofCards.third.map((card, index) => (
            <a class:list={["bento-card", { "is-wide": card.wide }]} href={card.href} style={`--d:${index * 85}`}>
              <div class="bento-visual">
                {card.key === "exec" && <ExecutionVisual />}
                {card.key === "messages" && <MessagesVisual />}
              </div>
              <div class="bento-body">
                <span class="mono-label">{card.label}</span>
                <h3>{card.title}</h3>
                <p>{segments(card.body).map(({ code, part }) => (code ? <code>{part}</code> : part))}</p>
                <span class="pill">
                  {card.cta}
                  <Icon name="arrow-right" />
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="judge-a-block" data-reveal>
        <h3 class="judge-a-h3">Check the fit before you install</h3>
        <dl class="judge-a-facts">
          {
            fitFacts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>
                  {segments(fact.body).map(({ code, part }) => (code ? <code>{part}</code> : part))}
                  {fact.link && (
                    <>
                      {" "}
                      <a href={fact.link.href}>{fact.link.text}</a>
                    </>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="faq-layout judge-a-block judge-a-questions">
        <div data-reveal>
          <h3 class="judge-a-h3">Questions that remain</h3>
        </div>
        <div class="faq" data-reveal>
          {
            questions.map((item, index) => (
              <details class="faq-item">
                <summary>
                  <span class="faq-num">{String(index + 1).padStart(2, "0")}</span>
                  <span class="faq-q">{item.q}</span>
                  <span class="faq-icon">
                    <Icon name="plus" />
                  </span>
                </summary>
                <p>{segments(item.a).map(({ code, part }) => (code ? <code>{part}</code> : part))}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Start: the quickstart and install panel that closes chapter 03 -->
  <section class="final" aria-labelledby="final-title">
    <div class="frame">
      <div class="final-panel" data-reveal>
        <svg class="final-bolt" viewBox="0 0 120 220" aria-hidden="true">
          <path d="M78 4 L18 128 H56 L40 216 L104 84 H64 Z" pathLength="1"></path>
        </svg>
        <p class="mono-label">Get started</p>
        <h2 id="final-title">Run your first system</h2>
        <p class="final-lede">
          Two structs, one method, and a schedule. The quickstart's complete program is 39 lines and prints 1.
        </p>
        <div class="hero-actions">
          <a class="button" href={ev.links.quickstart}>
            Read the quickstart
            <Icon name="arrow-right" />
          </a>
          <InstallCommand command={ev.install} />
        </div>
        <p class="judge-a-final-note">{ev.facts.requirements}</p>
      </div>
    </div>
  </section>
</AltLayout>
