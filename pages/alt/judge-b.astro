---
/**
 * Judge B's structure: the question ladder with the grafts from both judges.
 * Spec: .arena/landing/judge-b.md sections 4 to 6, copy from .arena/landing/proposal.md,
 * with the overrides in .arena/landing/v2/brief.md section 7 ("judge-b").
 * Eight blocks: hero, 01 code, 02 compile time, 03 performance, 04 what you get, 05 sample, 06 fit, 07 start.
 */
import AltLayout from "../_alt/AltLayout.astro";
import "../_alt/judge-b.css";
import { Code } from "astro:components";
import { Image } from "astro:assets";
import data from "blume:data";
import archeoids from "../../docs/samples/archeoids.png";
import Icon from "../_home/Icon.astro";
import InstallCommand from "../_home/InstallCommand.astro";
import TaglineReveal from "../_home/TaglineReveal.astro";
import AotVisual from "../_home/visuals/AotVisual.astro";
import ExecutionVisual from "../_home/visuals/ExecutionVisual.astro";
import MessagesVisual from "../_home/visuals/MessagesVisual.astro";
import QueryVisual from "../_home/visuals/QueryVisual.astro";
import ScheduleVisual from "../_home/visuals/ScheduleVisual.astro";
import StorageVisual from "../_home/visuals/StorageVisual.astro";
import * as ev from "../_alt/evidence";

const codeTheme = data.config.codeThemes.dark;

const title = "Archevolt: simulate thousands of entities in plain C#";
const description =
  "A headless entity component system for .NET. Write structs and static methods. A source generator turns them into direct calls, and simple float math into SIMD loops.";

/** Split text on backticks so inline code renders as <code>. */
const segments = (text: string) => text.split("`").map((part, index) => ({ code: index % 2 === 1, part }));
const two = (index: number) => String(index + 1).padStart(2, "0");
/** Print a measurement with the precision it was recorded at: 22.0 stays 22.0, 83.06 stays 83.06. */
const us = (value: number) => (Number.isInteger(value) ? value.toFixed(1) : String(value));
const range = ([low, high]: [number, number]) => `[${us(low)}, ${us(high)}]`;

/* Hero */

const values = [
  { name: "Ergonomic API", proof: "Two structs and a method", href: "#code" },
  {
    name: "Compile time",
    proof: `${ev.diagnostics.total} diagnostics, ${ev.diagnostics.errors} of them errors`,
    href: "#compile",
  },
  { name: "Performance", proof: `${us(ev.perfFacts.kernel.after)} µs to move 100,000 entities`, href: "#performance", note: true },
  { name: "Flexible architecture", proof: "One game on desktop and in a browser", href: "#sample" },
];

/* 02: the method a reader sees, cut from the hero snippet so it cannot drift from it */

const moveMethod = ev.heroCode.slice(ev.heroCode.indexOf("public static partial class Motion"));
const avSplit = ev.av006.indexOf(":") + 1;

// docs/concepts/architecture.mdx, the "Generated at compile time / Handled at run time" table.
const compileSplit = [
  ["Named query rows, enumerators, and shapes", "Which archetypes currently match a query"],
  ["Direct calls to your system methods", "Table traversal and row-range partitioning"],
  ["Bundle descriptors and module manifests", "World registration and validation"],
  ["Declarative schedule plans", "Binding, barriers, and command playback"],
];

/* 03 */

const maxUs = Math.max(...ev.movement.map((row) => row.us));
const kindTag: Record<ev.MovementRow["kind"], string> = {
  archevolt: "",
  reference: "reference",
  baseline: "baseline, no scheduler",
};

// docs/performance.mdx, "Dense movement at 100,000 entities": 2 November 2026, commit 8029e7f, an idle
// AMD Ryzen 9 5950X, Release build, median of three processes in µs with the fastest and slowest in brackets.
const eachBlockRows: { name: string; us: number; range: [number, number] }[] = [
  { name: "`[EachBlock]`, indexed loop", us: 83.06, range: [82.99, 83.17] },
  { name: "`[EachBlock]`, `Vector256` you write yourself", us: 20.96, range: [20.91, 21.07] },
];

// docs/performance.mdx, "Things that cost". Same checkpoint: 2 November 2026, commit 8029e7f, one machine.
const costs = [
  "Structural churn moves rows between archetypes. An idle tag insert and remove costs about 87 ns per entity at 1,000 entities.",
  "Small workloads can cost more to dispatch in parallel than to run serially.",
  "Writable access stamps a change on tracked components even when the value is equal.",
  "The first command playback without preallocated command capacity allocated 160.12 KB for 1,000 tag round trips. With 65,536 initial command bytes, it allocated 232 B.",
];

/* 04 */

const features = [
  {
    key: "query",
    wide: true,
    label: "Queries",
    title: "Typed rows, no lookups",
    body: "Named queries produce concrete rows with `ref` and `ref readonly` access. Nothing is boxed or looked up by type at run time.",
    href: ev.links.queries,
    cta: "Queries guide",
  },
  {
    key: "storage",
    label: "Storage",
    title: "Dense native tables",
    body: "Components live in aligned, structure of arrays tables, one per archetype, outside the managed heap.",
    href: ev.links.architecture,
    cta: "Architecture",
  },
  {
    key: "schedule",
    label: "Schedules",
    title: "Ordering you declare once",
    body: "Order systems with `Order`, `Before`, `After`, stages, and sets. The planner adds conservative ordering where access conflicts.",
    href: ev.links.schedules,
    cta: "Schedules guide",
  },
  {
    key: "exec",
    wide: true,
    label: "Execution",
    title: "Parallel when you ask for it",
    body: "Serial execution is the reference behavior. Enable a bounded worker pool and mark eligible systems as partitioned.",
    href: ev.links.execution,
    cta: "Execution guide",
  },
  {
    key: "messages",
    label: "Data flow",
    title: "Changes, resources, messages",
    body: "Track added and changed components, share resources, and send messages that each reader consumes at its own pace.",
    href: ev.links.messages,
    cta: "Messages guide",
  },
];

const guides = data.routes
  .filter((route) => route.path.includes("/guides/") && route.indexable && !route.hidden)
  .map((route) => route.title);

/* 05 */

const callouts = [
  { label: "ship", x: 52.9, y: 46.7 },
  { label: "rock", x: 55.5, y: 24.1 },
  { label: "rock", x: 35.9, y: 57.5 },
  { label: "8 entities", x: 91.5, y: 91.1, align: "end" },
];

/* 06: the fit list is also the page's FAQPage data */

const fit = [
  { label: "Engine", q: "Is Archevolt a game engine?", a: `No. ${ev.facts.engine}` },
  { label: "Package", q: "What do I install?", a: ev.facts.package },
  {
    label: "Requirements",
    q: "What does it require?",
    a: ev.facts.requirements,
    link: { href: ev.links.installation, text: "Read the installation guide" },
  },
  {
    label: "Deployment",
    q: "Does it work with trimming and NativeAOT?",
    a: `Yes. ${ev.facts.deployment}`,
    link: { href: ev.links.validation, text: "Validation and limits" },
  },
  {
    label: "Threads",
    q: "Does it run systems in parallel?",
    a: ev.facts.threads,
    link: { href: ev.links.execution, text: "Execution guide" },
  },
  { label: "Structural changes", q: "How do systems add or remove components?", a: ev.facts.structural },
  { label: "Limits", q: "Where does it stop?", a: ev.facts.ownership },
  {
    label: "Status",
    q: "Is the API stable?",
    a: `No. ${ev.facts.status}`,
    link: { href: ev.links.roadmap, text: "Read the roadmap" },
  },
  {
    label: "Comparisons",
    q: "How does it compare to other ECS libraries?",
    a: ev.facts.comparisons,
    link: { href: ev.links.results, text: "Benchmark results" },
  },
  {
    label: "License",
    q: "Is it free to use?",
    a: `Yes. ${ev.facts.license}`,
    link: { href: ev.links.github, text: "Source on GitHub" },
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: fit.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a.replaceAll("`", "") },
  })),
};

// The newest release page from Blume's GitHub Releases source, so no version is written into this file.
const releaseVersion = (text: string) => /^v?(\d+)\.(\d+)\.(\d+)$/.exec(text.trim())?.slice(1).map(Number);
const latestRelease = data.routes
  .filter((route) => route.path.includes("/changelog/") && !route.hidden && !route.draft)
  .map((route) => ({ route, version: releaseVersion(route.title) }))
  .filter((entry): entry is { route: typeof entry.route; version: number[] } => entry.version !== undefined)
  .sort((a, b) => b.version[0] - a.version[0] || b.version[1] - a.version[1] || b.version[2] - a.version[2])[0]?.route;

/* 07 */

const steps = [
  {
    title: "Add the package",
    body: "One package holds the runtime and its source generator. Generated declarations stay in your namespace and your partial types.",
    command: ev.install,
  },
  {
    title: "Collect systems into a module",
    body: "A module gathers systems and bundles. A schedule declares which systems run and in what order.",
    code: ev.moduleCode,
  },
  {
    title: "Build a world and run it",
    body: "Spawn entities from bundles, bind the schedule to the world, and run it once per update.",
    code: ev.runCode,
  },
];
---

<AltLayout slug="judge-b" title={title} description={description}>
  <!-- Hero: is this for my problem? -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="frame hero-inner">
      <p class="hero-badge" data-rise style="--d:0">
        <span class="pulse-dot"></span>
        Headless ECS for .NET · MIT
      </p>
      <h1 class="hero-title" id="hero-title" data-rise style="--d:90">
        Simulate thousands of entities{" "}<br />
        in plain C#
      </h1>
      <div class="hero-grid">
        <div class="hero-left">
          <p class="hero-lede" data-rise style="--d:180">
            Archevolt is an entity component system for .NET. You write components as structs and systems as static
            methods. At build time, a source generator turns them into direct calls, and simple float math into SIMD
            loops, with no reflection at run time.
          </p>
          <div class="hero-actions" data-rise style="--d:270">
            <a class="button" href={ev.links.quickstart}>
              Read the quickstart
              <Icon name="arrow-right" />
            </a>
            <InstallCommand command={ev.install} />
          </div>
          <p class="judge-b-status" data-rise style="--d:330">
            <span class="judge-b-status-tag">Status</span>
            Research project with no users. The API can change without compatibility shims. Requires the .NET 11 SDK
            and C# 15. <a href={ev.links.installation}>Check the requirements</a>
          </p>
          <ul class="judge-b-values" data-rise style="--d:390" aria-label="What Archevolt values, each linked to its proof">
            {
              values.map((value) => (
                <li>
                  <a href={value.href}>
                    <span class="judge-b-values-name">{value.name}</span>
                    <span class="judge-b-values-proof">
                      <span>
                        {value.proof}
                        {value.note && <sup aria-hidden="true">*</sup>}
                      </span>
                      <Icon name="arrow-right" />
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="hero-footnote" data-rise style="--d:450">
            <span aria-hidden="true">* </span>One worker, 5 November 2026, one machine. The SIMD kernel is on main and
            not yet in a NuGet release.
          </p>
        </div>
        <div class="judge-b-stage" data-rise style="--d:300">
          <div class="hero-stage" aria-hidden="true">
            <canvas class="hero-field" data-field></canvas>
            <div class="hero-hud">
              <span>entities <b data-hud-entities>0</b></span>
              <span>archetypes <b>4</b></span>
              <span>tick <b data-hud-tick>000000</b></span>
            </div>
          </div>
          <p class="judge-b-stage-note">
            Illustration. Entities move between archetype tables as they gain and lose components. The animation runs no
            Archevolt code.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 01: what would I write? -->
  <section class="section judge-b-anchor" id="code" aria-labelledby="code-title">
    <div class="frame">
      <div class="sec-label judge-b-label" data-reveal>
        <span>01</span>The code<span class="judge-b-value">Value · Ergonomic API</span>
      </div>
      <div class="system">
        <div class="system-copy" data-reveal>
          <h2 class="sec-title" id="code-title">Two structs and a method. That is the whole system.</h2>
          <p class="sec-lede">
            Components are unmanaged structs. A system is a static method that asks for <code>ref</code> to write and
            <code>in</code> to read. You write the simulation. The generator writes the query, the access plan, the schedule
            wiring, and the loop. If you know Bevy, the shape will look familiar.
          </p>
          <ul class="system-facts">
            <li><span>Typed access</span>Concrete rows. Nothing is boxed or looked up by type.</li>
            <li><span>Your namespace</span>Generated members go into your own partial types and namespace.</li>
            <li>
              <span>The cost</span>Types the generator extends must be <code>partial</code> (AV001). Components must be
              unmanaged (AV002). Schedules are declared with attributes.
            </li>
          </ul>
        </div>
        <figure class="window system-window" data-reveal data-story="system">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="window-file">Motion.cs</span>
            <span class="window-tag">your code · per entity</span>
          </div>
          <div class="code">
            <Code code={ev.heroCode} lang="csharp" theme={codeTheme} />
            <span class="code-hot" aria-hidden="true"><span>runs for every matching row</span></span>
          </div>
        </figure>
      </div>
      <p class="sec-foot" data-reveal>
        Read the <a href={ev.links.systems}>Systems guide</a> and the <a href={ev.links.queries}>Queries guide</a> for
        every parameter a system can ask for.
      </p>
    </div>
  </section>

  <TaglineReveal lines={["You write the method.", "The generator writes the loop.", "What it cannot generate fails the build."]} />

  <!-- 02: what does the generator do, and what does it cost me? -->
  <section class="section judge-b-anchor" id="compile" aria-labelledby="compile-title">
    <div class="frame">
      <div class="sec-label judge-b-label" data-reveal>
        <span>02</span>At compile time<span class="judge-b-value">Behind all three values</span>
      </div>
      <div data-reveal>
        <h2 class="sec-title judge-b-wide" id="compile-title">
          The readable version is the fast version
        </h2>
        <p class="sec-lede">
          Every float that <code>Motion.Move</code> writes gets the same formula. So in a Release build, the generator
          compiles it into a <code>Vector256</code> loop over the component columns. You keep the method. The build writes
          the loop you would otherwise write by hand.
        </p>
      </div>
      <div class="judge-b-pair" data-reveal>
        <figure class="window">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="window-file">Motion.cs</span>
            <span class="window-tag">you write</span>
          </div>
          <div class="code">
            <Code code={moveMethod} lang="csharp" theme={codeTheme} />
          </div>
        </figure>
        <figure class="window judge-b-dense">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="window-file">Motion.Move.g.cs</span>
            <span class="window-tag">generated · Release build</span>
          </div>
          <div class="code">
            <Code code={ev.generatedKernel} lang="csharp" theme={codeTheme} />
          </div>
        </figure>
      </div>
      <p class="judge-b-note" data-reveal>
        Real generator output, captured from main on 5 November 2026. Excerpt, with namespace prefixes and the
        <code>Vector128</code> branch removed. The kernel is on main and not yet in a NuGet release.
      </p>

      <div class="judge-b-split">
        <div data-reveal>
          <h3 class="judge-b-h3">Which methods become kernels</h3>
          <ul class="system-facts judge-b-facts">
            <li><span>Qualifies</span>{ev.kernelScope.qualifies}</li>
            <li><span>Keeps the call</span>{ev.kernelScope.doesNot}</li>
            <li><span>Same bits</span>{ev.kernelScope.correctness}</li>
            <li><span>Debug builds</span>{ev.kernelScope.debug}</li>
          </ul>
        </div>
        <div data-reveal>
          <h3 class="judge-b-h3">Mistakes fail the build</h3>
          <p class="judge-b-copy">
            A declaration that cannot compile to the generated form fails the build instead of falling back at run time.
            Archevolt has {ev.diagnostics.total} diagnostics, and {ev.diagnostics.errors} of them are errors.
            {ev.diagnostics.warning} warns.
          </p>
          <figure class="window judge-b-build">
            <div class="window-bar">
              <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
              <span class="window-file">dotnet build</span>
              <span class="window-tag">build output</span>
            </div>
            <div class="judge-b-build-out">
              <span><span class="judge-b-build-prompt">$</span> dotnet build</span>
              <span><span class="judge-b-build-error">{ev.av006.slice(0, avSplit)}</span>{ev.av006.slice(avSplit)}</span>
            </div>
          </figure>
          <p class="judge-b-note">
            The message for a query that filters on <code>Changed&lt;Position&gt;</code> when <code>Position</code> has no
            <code>[TrackChanges]</code>. The code never reaches run time.
          </p>
        </div>
      </div>

      <div class="judge-b-more" data-reveal>
        <details class="faq-item">
          <summary>
            <span class="faq-q">What the generator writes, and what the runtime decides</span>
            <span class="faq-icon"><Icon name="plus" /></span>
          </summary>
          <div class="judge-b-more-body is-pair">
            <div class="judge-b-table-wrap">
              <table class="judge-b-table">
                <thead>
                  <tr>
                    <th scope="col">Generated at compile time</th>
                    <th scope="col">Handled at run time</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    compileSplit.map(([generated, runtime]) => (
                      <tr>
                        <td>{generated}</td>
                        <td>{runtime}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <figure class="window judge-b-dense">
              <div class="window-bar">
                <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                <span class="window-file">Motion.Move.g.cs</span>
                <span class="window-tag">the same file's Run</span>
              </div>
              <div class="code">
                <Code code={ev.generatedRun} lang="csharp" theme={codeTheme} />
              </div>
            </figure>
          </div>
        </details>
      </div>
      <p class="sec-foot" data-reveal>
        Read the <a href={ev.links.architecture}>architecture overview</a>, the
        <a href={ev.links.diagnostics}>diagnostics reference</a>, and the
        <a href={ev.links.simdKernels}>SIMD kernel rules</a>.
      </p>
    </div>
  </section>

  <!-- 03: is it fast, and how do I know? -->
  <section class="section judge-b-anchor" id="performance" aria-labelledby="perf-title">
    <div class="frame">
      <div class="sec-label judge-b-label" data-reveal>
        <span>03</span>Performance<span class="judge-b-value">Value · Performance</span>
      </div>
      <div data-reveal>
        <h2 class="sec-title" id="perf-title">Speed is a requirement</h2>
        <p class="sec-lede">
          Every design decision is judged by what it costs in the update loop. On 5 November, a generated SIMD kernel
          moved 100,000 entities in {us(ev.perfFacts.kernel.after)} µs on one worker, down from
          {us(ev.perfFacts.kernel.before)} µs for the same <code>[Each]</code> method. Bevy 0.20 measured
          {us(ev.perfFacts.bevyParity.bevy)} µs for the same update on 2 November, on the same machine. The dense movement
          update now matches Bevy's.
        </p>
      </div>

      <p class="judge-b-kicker" data-reveal>Decisions that follow from it</p>
      <ul class="system-facts judge-b-decisions" data-reveal>
        <li>
          <span>Storage</span>Unmanaged structs in dense, aligned, structure of arrays tables outside the managed heap,
          one table per archetype.
        </li>
        <li><span>Dispatch</span>Direct calls from generated code. No reflection, boxing, delegates, or lookup by type.</li>
        <li><span>Threads</span>Parallel execution is opt-in, bounded, and partitionable. Serial is the default.</li>
        <li><span>Deployment</span>Runs under trimming and NativeAOT, with no runtime package dependencies.</li>
      </ul>

      <div class="perf judge-b-perf">
        <div class="perf-hero" data-reveal>
          <p class="perf-number judge-b-perf-number">{us(ev.perfFacts.kernel.after)}<small>µs</small></p>
          <p class="perf-caption judge-b-perf-caption">
            {ev.perfFacts.kernel.scope} On main, not yet in a NuGet release.
          </p>
          <dl class="perf-minis">
            <div>
              <dt>{ev.perfFacts.allocation.scope}</dt>
              <dd>{ev.perfFacts.allocation.value}</dd>
            </div>
            <div>
              <dt>{ev.perfFacts.dispatch.scope} Round one, 5 November 2026.</dt>
              <dd>{ev.perfFacts.dispatch.before} to {ev.perfFacts.dispatch.after} µs</dd>
            </div>
            <div>
              <dt>{ev.perfFacts.trackedWrite.scope} Round two, 5 November 2026.</dt>
              <dd>{ev.perfFacts.trackedWrite.before} to {ev.perfFacts.trackedWrite.after} µs</dd>
            </div>
          </dl>
        </div>
        <div class="perf-chart" data-reveal data-bars>
          <p class="perf-chart-title">
            Moving 100,000 entities on one worker, median µs per update
            <span>
              Archevolt's times include schedule dispatch, resource access, lease checks, and query traversal. The C#
              handwritten loop has no scheduler.
            </span>
          </p>
          <table>
            <thead>
              <tr>
                <th scope="col">Case</th>
                <th scope="col" class="num">Median µs</th>
                <th scope="col" class="num">Range</th>
                <th scope="col" class="num">Measured</th>
              </tr>
            </thead>
            <tbody>
              {
                ev.movement.map((row) => (
                  <tr class:list={{ "is-baseline": row.kind !== "archevolt" }}>
                    <th scope="row">
                      <span class="bar-label">
                        {segments(row.name).map(({ code, part }) => (code ? <code>{part}</code> : part))}
                        {kindTag[row.kind] && <span class="bar-tag">{kindTag[row.kind]}</span>}
                      </span>
                      <span class="bar" style={`--w:${((row.us / maxUs) * 100).toFixed(2)}%`}>
                        <span class="bar-fill" />
                      </span>
                    </th>
                    <td class="num">{us(row.us)}</td>
                    <td class="num judge-b-range">{range(row.range)}</td>
                    <td class="num judge-b-date">{row.date}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
      <p class="sec-foot" data-reveal>{ev.movementNote}</p>

      <div class="judge-b-split">
        <div data-reveal>
          <h3 class="judge-b-h3">How a change gets in</h3>
          <p class="judge-b-copy">
            Performance work goes through a hill climb. A candidate either clears the gate or goes into the ledger as a
            rejected experiment.
          </p>
          <ol class="judge-b-process">
            {ev.perfProcess.map((rule) => <li>{rule}</li>)}
          </ol>
          <p class="judge-b-note">
            Read the <a class="judge-b-link" href={ev.links.roundOne}>round one report</a> and the
            <a class="judge-b-link" href={ev.links.roundTwo}>round two report</a>.
          </p>
        </div>
        <div data-reveal>
          <h3 class="judge-b-h3">The known work</h3>
          <p class="judge-b-copy">
            These are the places where Archevolt is still slower than Bevy, with the cause the round two report names
            for each.
          </p>
          <ul class="judge-b-gaps">
            {
              ev.gaps.map((gap) => (
                <li>
                  <p class="judge-b-gap-case">
                    {segments(gap.case).map(({ code, part }) => (code ? <code>{part}</code> : part))}
                  </p>
                  <dl class="judge-b-gap-nums">
                    <div>
                      <dt>Archevolt</dt>
                      <dd>{gap.now}</dd>
                    </div>
                    {gap.bevy && (
                      <div>
                        <dt>Bevy 0.20</dt>
                        <dd>{gap.bevy}</dd>
                      </div>
                    )}
                  </dl>
                  <p class="judge-b-gap-note">{gap.note}</p>
                </li>
              ))
            }
          </ul>
          <p class="judge-b-note">
            Archevolt measured 5 November 2026 and Bevy 0.20 on 2 November, on the same AMD Ryzen 9 5950X. One machine,
            not a ranking. <a class="judge-b-link" href={ev.links.whatRemains}>Read what remains</a>
          </p>
        </div>
      </div>

      <div class="judge-b-more" data-reveal>
        <details class="faq-item">
          <summary>
            <span class="faq-q">When you want to write the loop yourself</span>
            <span class="faq-icon"><Icon name="plus" /></span>
          </summary>
          <div class="judge-b-more-body is-pair">
            <div>
              <p class="judge-b-copy judge-b-flush">
                <code>[EachBlock]</code> calls your method once per block of matching entities and passes each component
                as a span. Use it for a method that does not qualify for a kernel, or when you want to write the
                <code>Vector256</code> code yourself.
              </p>
              <ul class="judge-b-more-list judge-b-gap-top">
                {
                  eachBlockRows.map((row) => (
                    <li>
                      {segments(row.name).map(({ code, part }) => (code ? <code>{part}</code> : part))}:{" "}
                      <b>{us(row.us)} µs</b> {range(row.range)}
                    </li>
                  ))
                }
              </ul>
              <p class="judge-b-note">
                Moving 100,000 entities on one worker, median of three processes with the fastest and slowest in
                brackets. Measured 2 November 2026 at commit 8029e7f on an idle AMD Ryzen 9 5950X.
              </p>
            </div>
            <figure class="window judge-b-dense">
              <div class="window-bar">
                <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                <span class="window-file">MotionKernel.cs</span>
                <span class="window-tag">you write the loop</span>
              </div>
              <div class="code">
                <Code code={ev.eachBlockCode} lang="csharp" theme={codeTheme} />
              </div>
            </figure>
          </div>
        </details>
        <details class="faq-item">
          <summary>
            <span class="faq-q">Things that cost in the update loop</span>
            <span class="faq-icon"><Icon name="plus" /></span>
          </summary>
          <div class="judge-b-more-body">
            <ul class="judge-b-more-list">
              {costs.map((cost) => <li>{cost}</li>)}
            </ul>
            <p class="judge-b-note judge-b-flush">
              From the performance page. Measured 2 November 2026 at commit 8029e7f on one machine.
            </p>
          </div>
        </details>
      </div>

      <div class="judge-b-rerun" data-reveal>
        <p class="judge-b-rerun-label">Rerun the suite on your machine</p>
        <InstallCommand command={ev.rerunBenchmarks} />
        <a class="button" href={ev.links.performance}>
          Read the full performance report
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>

  <!-- 04: does it cover the rest of my program? -->
  <section class="section judge-b-anchor" id="features" aria-labelledby="features-title">
    <div class="frame">
      <div class="sec-label" data-reveal><span>04</span>What you get</div>
      <div data-reveal>
        <h2 class="sec-title judge-b-wide" id="features-title">
          Queries, storage, schedules, threads, and messages in one package
        </h2>
        <p class="sec-lede">Each card opens the page in the docs that covers it.</p>
      </div>
      <div class="bento judge-b-bento" data-scene>
        {
          features.map((feature, index) => (
            <a class:list={["bento-card", { "is-wide": feature.wide }]} href={feature.href} style={`--d:${index * 85}`}>
              <div class="bento-visual">
                {feature.key === "query" && <QueryVisual />}
                {feature.key === "storage" && <StorageVisual />}
                {feature.key === "schedule" && <ScheduleVisual />}
                {feature.key === "exec" && <ExecutionVisual />}
                {feature.key === "messages" && <MessagesVisual />}
              </div>
              <div class="bento-body">
                <span class="mono-label">{feature.label}</span>
                <h3>{feature.title}</h3>
                <p>{segments(feature.body).map(({ code, part }) => (code ? <code>{part}</code> : part))}</p>
                <span class="pill">
                  {feature.cta}
                  <Icon name="arrow-right" />
                </span>
              </div>
            </a>
          ))
        }
        <a class="bento-card bento-guides" href={ev.links.guides} style={`--d:${features.length * 85}`}>
          <div class="bento-visual">
            <div class="viz viz-guides" aria-hidden="true">
              <div class="vg-list">
                {
                  [0, 1].map(() => (
                    <ul>
                      {guides.map((guide, index) => (
                        <li>
                          <span>{two(index)}</span>
                          {guide}
                        </li>
                      ))}
                    </ul>
                  ))
                }
              </div>
            </div>
          </div>
          <div class="bento-body">
            <span class="mono-label">Guides</span>
            <h3>{guides.length} guides, one per feature</h3>
            <p>Components, modules, queries, schedules, resources, commands, and the rest, each with code examples.</p>
            <span class="pill">
              Explore the docs
              <Icon name="arrow-right" />
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 05: has anything real been built with it? -->
  <section class="section judge-b-anchor" id="sample" aria-labelledby="sample-title">
    <div class="frame">
      <div class="sec-label judge-b-label" data-reveal>
        <span>05</span>Sample<span class="judge-b-value">Value · Flexible architecture</span>
      </div>
      <div class="arcade" data-reveal>
        <div class="arcade-copy">
          <h2 class="sec-title" id="sample-title">Every ship, rock, bullet, and particle is an entity</h2>
          <p>
            Archeoids is a playable Asteroids style game. Archevolt runs the gameplay. {ev.sample.hosts}
          </p>
          <a class="button" href={ev.links.browserGame}>
            Play Archeoids in your browser
            <Icon name="arrow-right" />
          </a>
          <p class="judge-b-arcade-note">{ev.sample.browserNote}</p>
          <InstallCommand command={ev.runSample} />
          <a class="pill pill-light" href={ev.links.sample}>
            Explore the Archeoids sample
            <Icon name="arrow-right" />
          </a>
        </div>
        <div class="arcade-screen" data-story="arcade">
          <Image
            src={archeoids}
            alt="Archeoids gameplay with a cyan ship, drifting asteroids, and a score and lives HUD."
            widths={[640, 1100, 1600]}
            sizes="(min-width: 1024px) 640px, 100vw"
            loading="lazy"
          />
          {
            callouts.map((callout, index) => (
              <span
                class:list={["callout", { "is-end": callout.align === "end" }]}
                style={`left:${callout.x}%;top:${callout.y}%`}
                data-callout={index}
                aria-hidden="true"
              >
                <span class="callout-ring" />
                <span class="callout-tag">entity · {callout.label}</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 06: does it fit my constraints? -->
  <section class="section judge-b-anchor" id="fit" aria-labelledby="fit-title">
    <div class="frame">
      <div class="sec-label" data-reveal><span>06</span>Fit</div>
      <div data-reveal>
        <h2 class="sec-title" id="fit-title">A library, not an engine</h2>
        <p class="sec-lede">
          Your program decides the shape. Archevolt holds the simulation state and the systems that change it, and the
          host is yours. Check these before you install.
        </p>
      </div>
      <div class="judge-b-runs">
        <div class="targets judge-b-targets" data-reveal data-story="targets">
          <p class="targets-label">Runs under</p>
          <p class="targets-row">
            <span data-target-word>JIT</span><span class="targets-sep">/</span><span data-target-word>Trimmed</span><span
              class="targets-sep">/</span
            ><span data-target-word>NativeAOT</span>
          </p>
          <p class="targets-note">The same package, verified in clean consumers on each. NativeAOT evidence is Windows x64.</p>
        </div>
        <div class="bento-visual judge-b-aot" data-reveal>
          <AotVisual />
        </div>
      </div>
      <ul class="judge-b-fit" data-reveal>
        {
          fit.map((item) => (
            <li>
              <p class="judge-b-fit-label">{item.label}</p>
              <h3 class="judge-b-fit-q">{item.q}</h3>
              <p class="judge-b-fit-a">
                {segments(item.a).map(({ code, part }) => (code ? <code>{part}</code> : part))}
                {item.link && (
                  <a class="judge-b-link" href={item.link.href}>
                    {item.link.text}
                  </a>
                )}
              </p>
            </li>
          ))
        }
        <li>
          <p class="judge-b-fit-label">Releases</p>
          <h3 class="judge-b-fit-q">What is the latest release?</h3>
          <p class="judge-b-fit-a">
            {
              latestRelease ? (
                <>
                  {latestRelease.title} is the latest release. Releases can trail main, which holds the newest work.
                  <a class="judge-b-link" href={latestRelease.path}>
                    Read the {latestRelease.title} release notes
                  </a>
                </>
              ) : (
                <>
                  Releases can trail main, which holds the newest work.
                  <a class="judge-b-link" href={ev.links.changelog}>
                    Read the changelog
                  </a>
                </>
              )
            }
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- 07: how do I start, and how much do I write? -->
  <section class="section judge-b-anchor" id="start" aria-labelledby="steps-title">
    <div class="frame">
      <div class="sec-label" data-reveal><span>07</span>Start</div>
      <h2 class="sec-title sec-title-wide" id="steps-title" data-reveal>From package to running world in three steps</h2>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step" data-reveal>
              <span class="step-number" aria-hidden="true">
                {two(index)}
              </span>
              <div class="step-copy">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
              <div class="step-visual">
                {step.command ? (
                  <InstallCommand command={step.command} typed />
                ) : (
                  <div class="window">
                    <div class="code">
                      <Code code={step.code!} lang="csharp" theme={codeTheme} />
                    </div>
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="sec-foot" data-reveal>
        The <a href={ev.links.quickstart}>quickstart</a> puts these pieces together into one program that prints
        <code>1</code>.
      </p>
      <div class="final-panel judge-b-final" data-reveal>
        <svg class="final-bolt" viewBox="0 0 120 220" aria-hidden="true">
          <path d="M78 4 L18 128 H56 L40 216 L104 84 H64 Z" pathLength="1"></path>
        </svg>
        <p class="mono-label">Get started</p>
        <h3>Run your first system</h3>
        <p class="final-lede">Two structs, one method, and a schedule. The quickstart walks through the whole program.</p>
        <div class="hero-actions">
          <a class="button" href={ev.links.quickstart}>
            Read the quickstart
            <Icon name="arrow-right" />
          </a>
          <InstallCommand command={ev.install} />
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</AltLayout>
