<script>
  /*
   * Play on click. The poster stays until the visitor asks for the game, so the page never loads the
   * WebAssembly build unprompted. Narrow and touch screens never see the button (CSS), and this guard
   * keeps them out if it is reached anyway.
   */
  const noPlay = "(max-width: 767px), (hover: none) and (pointer: coarse)";

  const onClick = (event: Event) => {
    const target = event.target as Element | null;
    const play = target?.closest<HTMLButtonElement>("[data-game-play]");
    const stop = target?.closest<HTMLButtonElement>("[data-game-stop]");
    const screen = (play ?? stop)?.closest<HTMLElement>("[data-game]");
    const frame = screen?.querySelector<HTMLElement>("[data-game-frame]");
    const status = screen?.querySelector<HTMLElement>("[data-game-status]");
    if (!screen || !frame) return;

    if (play) {
      if (window.matchMedia(noPlay).matches) return;
      if (!("gpu" in navigator)) {
        if (status) status.textContent = "This browser does not expose WebGPU, so the game cannot start here. The desktop build draws with OpenGL instead.";
        return;
      }
      const iframe = document.createElement("iframe");
      iframe.src = screen.dataset.gameSrc ?? "";
      iframe.title = "Archeoids, the playable browser build";
      iframe.allow = "fullscreen";
      iframe.className = "experience-game";
      frame.append(iframe);
      screen.dataset.state = "playing";
      iframe.focus();
      if (status) status.textContent = "Loading. Click the game to give it the keyboard.";
      return;
    }

    frame.querySelector("iframe")?.remove();
    screen.dataset.state = "poster";
    if (status) status.textContent = "";
    screen.querySelector<HTMLElement>("[data-game-play]")?.focus();
  };

  document.addEventListener("click", onClick);
</script>
