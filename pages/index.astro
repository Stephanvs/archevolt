---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "./_home/home.css";
import { Image } from "astro:assets";
import { Code } from "astro:components";
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import archeoids from "../docs/samples/archeoids.png";
import Compare from "./_home/Compare.astro";
import Icon from "./_home/Icon.astro";
import InstallCommand from "./_home/InstallCommand.astro";
import TaglineReveal from "./_home/TaglineReveal.astro";
import { lightenComments, run, segments, wiring } from "./_home/sample";
import AotVisual from "./_home/visuals/AotVisual.astro";
import ExecutionVisual from "./_home/visuals/ExecutionVisual.astro";
import MessagesVisual from "./_home/visuals/MessagesVisual.astro";
import QueryVisual from "./_home/visuals/QueryVisual.astro";
import ScheduleVisual from "./_home/visuals/ScheduleVisual.astro";
import StorageVisual from "./_home/visuals/StorageVisual.astro";

const { config } = data;
const codeTheme = config.codeThemes.dark;

const title = "Archevolt: fast ECS for .NET games and simulations";
const description =
  "An entity component system (ECS) for .NET games and simulations. Write structs and plain C# methods. A source generator compiles them at build time.";

const quickstart = "/docs/getting-started/quickstart";
const install = "dotnet add package Archevolt";
const browserGame = "https://stephanvs.github.io/archevolt/";
const reports = "https://github.com/Stephanvs/archevolt/blob/main/benchmarks";

/*
 * Moving 100,000 entities on one thread, median µs per update, all on one AMD Ryzen 9 5950X. benchmarks/benchmark.md
 * describes the workload: every case adds a velocity, scaled by a time step, to a position of three floats.
 * Archevolt: benchmarks/performance-hill-climb-round-2.md, the slower of its two batches. The other measured 21.4.
 * That report says the result matches Bevy's, so the page says "matches" and does not claim a win.
 * The references: benchmarks/results.md. Each value keeps the precision of its report.
 */
const movement = [
  { name: "Rust, handwritten loop", us: "20.50", tag: "no ECS" },
  { name: "Archevolt `[Each]`", us: "22.0", archevolt: true },
  { name: "Bevy 0.20 `for_each`", us: "23.70" },
  { name: "C#, handwritten loop", us: "83.06", tag: "no ECS" },
  { name: "Arch 2.1.0, inline query", us: "103.5", tag: "no scheduler" },
];
const maxUs = Math.max(...movement.map((row) => Number(row.us)));

/*
 * docs/performance.mdx, and benchmarks/results.md for Bevy's scan. The system cost is 24.3 ns in the docs,
 * measured on a second machine.
 */
const costs = [
  { value: "0 B", label: "allocated per update after warm up, with one worker or four" },
  { value: "24 ns", label: "to run one `[Each]` system, before it visits an entity" },
  {
    value: "0.16 µs",
    label: "for a `Changed<T>` scan when nothing changed, at 1,000 or 100,000 entities. Bevy 0.20 takes 29 µs at 100,000.",
  },
];

const steps = [
  {
    title: "Add the package",
    body: "One package holds the runtime and the source generator. Your project needs .NET 11 and C# 15.",
    command: install,
  },
  {
    title: "Collect systems into a module",
    body: "A bundle lists the components an entity starts with. A module gathers systems and bundles, and a schedule declares which systems run, in what order. The generator writes `GameEcs.Module` and `Simulation.Create` from them.",
    code: wiring,
  },
  {
    title: "Build a world and run it",
    body: "Spawn entities from bundles, bind the schedule to the world, and call `Run` once per update.",
    code: run,
  },
];

const hosting = [
  {
    key: "exec",
    label: "Execution",
    title: "Parallel when you ask for it",
    body: "Systems run one at a time by default. Turn on the worker pool, and systems that do not conflict run together. A partitioned system also splits its rows across the workers.",
    href: "/docs/guides/execution",
    cta: "Execution guide",
  },
  {
    key: "aot",
    label: "Deployment",
    title: "Ready for NativeAOT",
    body: "The same package runs under the JIT, trimmed, or as a NativeAOT image.",
    href: "/docs/getting-started/installation",
    cta: "Installation",
  },
];

const features = [
  {
    key: "query",
    wide: true,
    label: "Queries",
    title: "Typed rows, no lookups",
    body: "Named queries produce concrete rows with `ref` and `ref readonly` access. Nothing is boxed or looked up by type at run time.",
    href: "/docs/guides/queries",
    cta: "Queries guide",
  },
  {
    key: "storage",
    label: "Storage",
    title: "Dense native tables",
    body: "Components live in aligned, structure of arrays tables, one per archetype, outside the managed heap.",
    href: "/docs/concepts/architecture",
    cta: "Architecture",
  },
  {
    key: "schedule",
    label: "Schedules",
    title: "Ordering you declare once",
    body: "Order systems with `Order`, `Before`, `After`, stages, and sets. The planner adds conservative ordering where access conflicts.",
    href: "/docs/guides/schedules",
    cta: "Schedules guide",
  },
  {
    key: "messages",
    label: "Data flow",
    title: "Changes, resources, messages",
    body: "Track added and changed components, share resources, and send messages that each reader consumes at its own pace.",
    href: "/docs/guides/messages",
    cta: "Messages guide",
  },
];

const guides = data.routes
  .filter((route) => route.path.includes("/guides/") && route.indexable && !route.hidden)
  .map((route) => route.title);

/* Each answer adds something the sections above do not say. */
const faqs = [
  {
    q: "Is Archevolt a game engine?",
    a: "No. It is a library that runs your simulation inside your own program, on .NET 11. You bring the window, input, and rendering, for example with Silk.NET, or run with no graphics at all. It has no integration for a specific engine.",
  },
  {
    q: "Which methods do not become SIMD loops?",
    a: "For example, a method that contains a loop, uses `%`, returns early, or takes an `Entity` or `Commands` parameter. Such a method still runs, as a plain loop that handles one entity at a time.",
    more: { label: "Read the rules in the systems guide", href: "/docs/guides/systems#simd-kernels" },
  },
  {
    q: "Can I step through a system in the debugger?",
    a: "Yes. A Debug build calls your method once per entity, so a breakpoint in it is hit. An optimized build copies the body of the method into the generated loop.",
  },
  {
    q: "Does it allocate during an update?",
    a: "Not after the first updates, as long as storage does not grow. Spawning and other structural changes can grow storage, and that allocates.",
  },
  {
    q: "What does the generator change in my code?",
    a: "It adds members to your declarations, so the types it touches must be `partial`. Generated code stays in your namespace, inside the partial type it extends.",
  },
  {
    q: "What happens when a declaration is wrong?",
    a: "The generator reports it when you build, with a numbered diagnostic such as `AV006` for a change filter on a component that is not tracked. All but one of the diagnostics fail the build.",
    more: { label: "See the diagnostics", href: "/docs/reference/diagnostics" },
  },
  {
    q: "How do systems add or remove components?",
    a: "Inside a system, record the change with `Commands`. The schedule applies it before the systems that depend on it run. Outside a schedule, change the world directly on its owner thread.",
  },
  {
    q: "How does it compare to other ECS libraries?",
    a: "On a test that moves 100,000 entities, Archevolt matches Bevy 0.20, and Arch 2.1.0 takes 103.5 µs against Archevolt's 22. In other tests Archevolt skips unchanged components faster than Bevy does, and is slower at `Get<T>` lookups and when it writes and then scans every tracked component. All of these ran on one machine.",
    more: { label: "See the benchmark results", href: `${reports}/results.md` },
  },
  {
    q: "Is it free to use?",
    a: "Yes. Archevolt is open source under the MIT license, and the source is on GitHub.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a.replaceAll("`", "") },
  })),
};

const two = (index: number) => String(index + 1).padStart(2, "0");
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  structuredDataEnabled={config.structuredData}
  lastModified="2026-11-13"
  page={{ title, description }}
>
  <div class="home" data-home>
    <!-- Hero: a live field of entities streaming through archetype tables -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="frame hero-inner">
        <p class="hero-badge" data-rise style="--d:0">
          <span class="pulse-dot"></span>
          Headless ECS for .NET · MIT
        </p>
        <h1 class="hero-title" id="hero-title" data-rise style="--d:90">
          Blazing fast simulations{" "}<br />
          in plain C#
        </h1>
        <div class="hero-grid">
          <div class="hero-left">
            <p class="hero-lede" data-rise style="--d:180">
              Archevolt is an entity component system, or ECS, for .NET games and simulations. You write components as
              structs and systems as static methods. A source generator compiles them into direct calls at build time,
              and your program keeps its own host, loop, and threads.
            </p>
            <div class="hero-actions" data-rise style="--d:270">
              <a class="button" href={quickstart}>
                Read the quickstart
                <Icon name="arrow-right" />
              </a>
              <InstallCommand command={install} />
            </div>
            <dl class="hero-proof" data-rise style="--d:360">
              <div><dt>to move 100,000 entities</dt><dd>22 µs</dd></div>
              <div><dt>allocated per update after warm up</dt><dd>0 B</dd></div>
              <div><dt>package dependencies</dt><dd>0</dd></div>
            </dl>
          </div>
          <div class="hero-stage" data-rise style="--d:300" aria-hidden="true">
            <canvas class="hero-field" data-field></canvas>
            <div class="hero-hud">
              <span>entities <b data-hud-entities>0</b></span>
              <span>archetypes <b>4</b></span>
              <span>tick <b data-hud-tick>000000</b></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 01: the sample beside what the generator writes for it -->
    <section class="section" id="generated" aria-labelledby="generated-title">
      <div class="frame">
        <div class="sec-label" data-reveal><span>01</span>Generated code</div>
        <div class="sec-head" data-reveal>
          <h2 class="sec-title" id="generated-title">The readable version is the fast version</h2>
          <p class="sec-lede">
            You do not rewrite <code>Motion.Move</code> for speed. Select a part of it to see what the generator wrote.
          </p>
        </div>
        <Compare />
        <p class="sec-foot" data-reveal>
          Methods with <code>if</code> branches, <code>MathF.Min</code> and <code>MathF.Max</code>, and calls to your
          own static methods can compile this way too. The{" "}
          <a href="/docs/guides/systems#simd-kernels">systems guide</a> lists what qualifies.
        </p>
      </div>
    </section>

    <!-- 02: performance -->
    <section class="section" id="performance" aria-labelledby="perf-title">
      <div class="frame">
        <div class="sec-label" data-reveal><span>02</span>Performance</div>
        <h2 class="sec-title sec-title-wide" id="perf-title" data-reveal>Speed is a requirement</h2>
        <div class="perf">
          <div class="perf-hero" data-reveal>
            <p class="perf-number">22<small>µs</small></p>
            <p class="perf-caption">
              to move 100,000 entities on one thread. That is 0.22 ns per entity, and it matches Bevy 0.20, which
              takes 23.7 µs on the same machine.
            </p>
            <dl class="perf-minis">
              {
                costs.map((cost) => (
                  <div>
                    <dt>{segments(cost.label).map(({ code, part }) => (code ? <code>{part}</code> : part))}</dt>
                    <dd>{cost.value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
          <div class="perf-chart" data-reveal data-bars>
            <p class="perf-chart-title">
              Moving 100,000 entities on one thread, median µs per update
              <span>
                Each entity adds its velocity, scaled by a time step, to a position of three floats. Archevolt and
                Bevy each run that as one system in a schedule.
              </span>
            </p>
            <table>
              <thead>
                <tr>
                  <th scope="col">Case</th>
                  <th scope="col" class="num">Median µs</th>
                </tr>
              </thead>
              <tbody>
                {
                  movement.map((row) => (
                    <tr class:list={{ "is-reference": !row.archevolt }}>
                      <th scope="row">
                        <span class="bar-label">
                          <span>{segments(row.name).map(({ code, part }) => (code ? <code>{part}</code> : part))}</span>
                          {row.tag && <span class="bar-tag">{row.tag}</span>}
                        </span>
                        <span class="bar" style={`--w:${((Number(row.us) / maxUs) * 100).toFixed(2)}%`}>
                          <span class="bar-fill" />
                        </span>
                      </th>
                      <td class="num">{row.us}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
        <p class="sec-foot" data-reveal>
          The chart shows medians of three process runs on an AMD Ryzen 9 5950X, in Release builds, from the{" "}
          <a href={`${reports}/performance-hill-climb-round-2.md#distance-to-bevy`}>round two report</a> and the{" "}
          <a href={`${reports}/results.md#movement-100000-entities-one-thread`}>benchmark results</a>. The system
          cost comes from a second machine. The <a href="/docs/performance">performance page</a> lists what costs.
        </p>
      </div>
    </section>

    <TaglineReveal lines={["Your components stay structs.", "Your systems stay methods.", "The generator writes the rest."]} />

    <!-- 03: setup, as editorial rows -->
    <section class="section" id="setup" aria-labelledby="setup-title">
      <div class="frame">
        <div class="sec-label" data-reveal><span>03</span>Setup</div>
        <h2 class="sec-title sec-title-wide" id="setup-title" data-reveal>Then wire it into a program</h2>
        <ol class="steps">
          {
            steps.map((step, index) => (
              <li class="step" data-reveal>
                <span class="step-number" aria-hidden="true">
                  {two(index)}
                </span>
                <div class="step-copy">
                  <h3>{step.title}</h3>
                  <p>{segments(step.body).map(({ code, part }) => (code ? <code>{part}</code> : part))}</p>
                </div>
                <div class="step-visual">
                  {step.command ? (
                    <InstallCommand command={step.command} typed />
                  ) : (
                    <div class="window">
                      <div class="code">
                        <Code code={step.code!} lang="csharp" theme={codeTheme} transformers={[lightenComments]} />
                      </div>
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
        <p class="sec-foot" data-reveal>
          The <a href={quickstart}>quickstart</a> walks through the complete program.
        </p>
      </div>
    </section>

    <!-- 04: headless -->
    <section class="section" id="headless" aria-labelledby="headless-title">
      <div class="frame">
        <div class="sec-label" data-reveal><span>04</span>Architecture</div>
        <div class="sec-head" data-reveal>
          <h2 class="sec-title" id="headless-title">Archevolt is headless</h2>
          <p class="sec-lede">
            No window, input, rendering, or audio. You call <code>simulation.Run()</code> from your own loop, in a game,
            a server, or a test.
          </p>
        </div>
        <div class="bento bento-pair" data-scene>
          {
            hosting.map((card, index) => (
              <a class="bento-card" href={card.href} style={`--d:${index * 85}`}>
                <div class="bento-visual">
                  {card.key === "exec" && <ExecutionVisual />}
                  {card.key === "aot" && <AotVisual />}
                </div>
                <div class="bento-body">
                  <span class="mono-label">{card.label}</span>
                  <h3>{card.title}</h3>
                  <p>{card.body}</p>
                  <span class="pill">
                    {card.cta}
                    <Icon name="arrow-right" />
                  </span>
                </div>
              </a>
            ))
          }
        </div>
        <a class="sample" href={browserGame} data-reveal>
          <Image src={archeoids} alt="" widths={[160, 320]} sizes="128px" loading="lazy" />
          <span class="sample-copy">
            <span class="sample-label">Sample · Archeoids</span>
            <span>The same simulation runs under Silk.NET on the desktop and under WebGPU in the browser.</span>
          </span>
          <span class="pill pill-page">
            Play it in your browser
            <Icon name="arrow-right" />
          </span>
        </a>
      </div>
    </section>

    <!-- 05: the other features, as a bento of live visuals -->
    <section class="section" id="features" aria-labelledby="features-title">
      <div class="frame">
        <div class="sec-label" data-reveal><span>05</span>What you get</div>
        <h2 class="sec-title sec-title-wide" id="features-title" data-reveal>
          Queries, storage, schedules, and messages
        </h2>
        <div class="bento" data-scene>
          {
            features.map((feature, index) => (
              <a class:list={["bento-card", { "is-wide": feature.wide }]} href={feature.href} style={`--d:${index * 85}`}>
                <div class="bento-visual">
                  {feature.key === "query" && <QueryVisual />}
                  {feature.key === "storage" && <StorageVisual />}
                  {feature.key === "schedule" && <ScheduleVisual />}
                  {feature.key === "messages" && <MessagesVisual />}
                </div>
                <div class="bento-body">
                  <span class="mono-label">{feature.label}</span>
                  <h3>{feature.title}</h3>
                  <p>{segments(feature.body).map(({ code, part }) => (code ? <code>{part}</code> : part))}</p>
                  <span class="pill">
                    {feature.cta}
                    <Icon name="arrow-right" />
                  </span>
                </div>
              </a>
            ))
          }
          <a class="bento-card bento-guides" href="/docs/guides/components-and-bundles" style={`--d:${features.length * 85}`}>
            <div class="bento-visual">
              <div class="viz viz-guides" aria-hidden="true">
                <div class="vg-list">
                  {
                    [0, 1].map(() => (
                      <ul>
                        {guides.map((guide, index) => (
                          <li>
                            <span>{two(index)}</span>
                            {guide}
                          </li>
                        ))}
                      </ul>
                    ))
                  }
                </div>
              </div>
            </div>
            <div class="bento-body">
              <span class="mono-label">Guides</span>
              <h3>A guide for every feature</h3>
              <p>Components, modules, queries, schedules, resources, commands, and the rest.</p>
              <span class="pill">
                Browse the guides
                <Icon name="arrow-right" />
              </span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- 06: FAQ -->
    <section class="section" id="faq" aria-labelledby="faq-title">
      <div class="frame faq-layout">
        <div>
          <div class="sec-label" data-reveal><span>06</span>FAQ</div>
          <h2 class="sec-title" id="faq-title" data-reveal>Questions before you start</h2>
        </div>
        <div class="faq" data-reveal>
          {
            faqs.map((faq, index) => (
              <details class="faq-item">
                <summary>
                  <span class="faq-num">{two(index)}</span>
                  <span class="faq-q">{faq.q}</span>
                  <span class="faq-icon">
                    <Icon name="plus" />
                  </span>
                </summary>
                <p>
                  {segments(faq.a).map(({ code, part }) => (code ? <code>{part}</code> : part))}
                  {faq.more && (
                    <>
                      {" "}
                      <a href={faq.more.href}>{faq.more.label}</a>
                    </>
                  )}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Final call to action -->
    <section class="final" aria-labelledby="final-title">
      <div class="frame">
        <div class="final-panel" data-reveal>
          <svg class="final-bolt" viewBox="0 0 120 220" aria-hidden="true">
            <path d="M78 4 L18 128 H56 L40 216 L104 84 H64 Z" pathLength="1"></path>
          </svg>
          <p class="mono-label">Get started</p>
          <h2 id="final-title">Build your first simulation</h2>
          <p class="final-lede">Getting started is easy. Add the package and follow the quickstart.</p>
          <div class="hero-actions">
            <a class="button" href={quickstart}>
              Read the quickstart
              <Icon name="arrow-right" />
            </a>
            <InstallCommand command={install} />
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </div>
</PageLayout>

<script>
  import { mountHome } from "./_home/home";

  let teardown: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    teardown?.();
    teardown = mountHome();
  });
  document.addEventListener("astro:before-swap", () => {
    teardown?.();
    teardown = undefined;
  });
</script>
